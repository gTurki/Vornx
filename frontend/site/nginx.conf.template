# nginx serves the public website. ${PORT} and ${VITE_API_URL} are filled in when the container starts.
# A location with its own add_header does NOT inherit the server's ones, so every location includes the snippet.
server {
    listen ${PORT};
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;
    gzip on;
    gzip_types text/css application/javascript image/svg+xml;

    # Images have a content hash in their name; CSS/JS are linked with ?v=<hash>: cache for a year.
    location /img/ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }
    location /assets/ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # The page itself is never cached, so a new deploy shows up immediately.
    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}
